# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Caches & Temporary directories
.ipynb_checkpoints/
.duckdb_temp/
.tmp/
*/.tmp/
.gemini/
tempCodeRunnerFile.py
*.log
run_phase6_pipeline.py
update_phase6_nb.py

# Environments & Virtual Envs
.env
.venv/
env/
venv/

# =====================================================================
# BIG DATA EXCLUSIONS (Avoid GitHub 100MB file limit)
# =====================================================================
# Exclude raw data (transactions_train.csv is 3.3GB, customers is 197MB)
data/raw/
data/processed/

# Exclude all large parquet tables (>50MB - 150MB each)
*.parquet
data/features/*.parquet
data/features/phase5_parts/
data/results/*.parquet
reports/tables/phase3_eda/*.parquet

# Whitelist small essential model binaries & reference CSVs
!data/models/final_cluster_model.joblib
!data/models/final_preprocessor.joblib
!data/models/final_preprocessing_metadata.csv
!data/features/phase6_candidate_feature_set.csv
!data/results/segment_fashion_preferences.csv
!data/results/segment_marketing_strategy.csv
